# Só pacotes do registo público do npm.
# Este projeto é público e o deploy corre no GitHub: nunca registos de empresas.
# Este ficheiro tem prioridade sobre o ~/.npmrc da máquina.
registry=https://registry.npmjs.org/

# Não reescrever o endereço dos pacotes no package-lock.json para outro registo.
replace-registry-host=never

# Nunca escrever credenciais aqui.
